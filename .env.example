# Copiar para .env e preencher:  cp .env.example .env
# NUNCA partilhar o ficheiro .env (tem as palavras-passe).

# Endereço da plataforma (o DNS tem de apontar para o IP do servidor)
MOODLE_DOMAIN=forum.liteacademy.eu

# Versão do Moodle (tag oficial). Para atualizar: mudar aqui e correr scripts/atualizar.sh
MOODLE_VERSION=v5.2.3

# Base de dados (gerar palavra-passe forte: openssl rand -base64 24)
DB_NAME=moodle
DB_USER=moodle
DB_PASSWORD=MUDAR_ISTO

# Conta de administrador criada na instalação
ADMIN_USER=admin
ADMIN_PASSWORD=MUDAR_ISTO
ADMIN_EMAIL=geral@liteacademy.eu
SITE_FULLNAME="Lite Academy"
SITE_SHORTNAME=LiteAcademy

# Email (SMTP) — caixa noreply@liteacademy.eu na PTisp
SMTP_HOST=mail.liteacademy.eu:465
SMTP_USER=noreply@liteacademy.eu
SMTP_PASSWORD=MUDAR_ISTO
SMTP_SECURE=ssl
NOREPLY_ADDRESS=noreply@liteacademy.eu

# Memória — ajustar ao plano do servidor:
#   4 GB RAM: APACHE_MAX_WORKERS=25  PG_SHARED_BUFFERS=512MB  PG_CACHE_SIZE=1536MB
#   6 GB RAM: APACHE_MAX_WORKERS=40  PG_SHARED_BUFFERS=1GB    PG_CACHE_SIZE=3GB
#   8 GB RAM: APACHE_MAX_WORKERS=55  PG_SHARED_BUFFERS=1536MB PG_CACHE_SIZE=4GB
APACHE_MAX_WORKERS=40
PG_SHARED_BUFFERS=1GB
PG_CACHE_SIZE=3GB

# Backups: quantos dias manter no servidor
BACKUP_KEEP_DAYS=7
# Cópia fora do servidor no Google Drive (configurar com scripts/configurar-drive.sh)
# Deixar vazio para desativar.
BACKUP_DRIVE=gdrive:LiteAcademy-Moodle
# Quantos dias de cópias da base de dados manter no Drive
BACKUP_DRIVE_KEEP_DAYS=14
# Alternativa: rsync/ssh (ex.: Hetzner Storage Box)  u123456@u123456.your-storagebox.de:moodle-backups
BACKUP_REMOTE=
